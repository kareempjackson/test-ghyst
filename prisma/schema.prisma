// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Zone {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingAsOrigin      Pricing[] @relation("OriginZone")
  pricingAsDestination Pricing[] @relation("DestinationZone")

  @@map("zones")
}

model Pricing {
  id             String   @id @default(cuid())
  fromZoneId     String
  toZoneId       String
  fareCents      Int
  currency       String   @default("USD")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fromZone Zone @relation("OriginZone", fields: [fromZoneId], references: [id])
  toZone   Zone @relation("DestinationZone", fields: [toZoneId], references: [id])

  @@unique([fromZoneId, toZoneId])
  @@map("pricing")
}
